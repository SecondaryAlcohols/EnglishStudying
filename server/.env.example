# 复制成 .env 再改。.env 不进 git。
DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/english_vocab
HOST=0.0.0.0
PORT=8000

# 登录令牌签名密钥。留空会在启动时随机生成 —— 进程一重启所有令牌就失效。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# 关掉之后只有管理员能建号；第一个注册的账号永远能成功并成为管理员
ALLOW_REGISTRATION=true
