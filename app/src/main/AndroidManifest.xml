<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连自建服务器（登录 / 下载词表 / 同步进度） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      词库文件通过 Storage Access Framework 读取，用户在选择器里显式授权，
      因此不需要 READ_EXTERNAL_STORAGE；朗读用的系统 TTS 也不需要权限。
    -->

    <!--
      Android 11 起应用默认看不到其他应用，要能发现 TTS 引擎就必须在这里声明查询意图。
      少了这段，TextToSpeech 初始化会拿不到引擎，表现为「喇叭点了没反应」。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".EnglishStudyingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.EnglishStudying">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EnglishStudying">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
